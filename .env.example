# Application Settings
PROJECT_NAME="Bulk Certificate Generator"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (Zero-Cost Local SQLite Default)
# For local SQLite, using SQLite with WAL mode enabled
DATABASE_URL="sqlite:///./data.db"

# Storage Settings (Local file storage, zero-cost)
STORAGE_DIR="./storage/certificates"
MAX_BATCH_SIZE=1000
MAX_FILE_RETENTION_HOURS=72

# Worker Configuration (Database-backed polling)
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_BATCH_SIZE=25
WORKER_JOB_TIMEOUT_SECONDS=600

# Security & CORS
ALLOWED_ORIGINS=["*"]

# Google OAuth 2.0 Authentication
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
JWT_SECRET_KEY="bulk-certificate-generator-jwt-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Free Cloud Storage (Cloudflare R2 or Supabase - S3 Compatible)
# Set STORAGE_PROVIDER to "r2", "supabase", or "s3" to enable cloud backup.
# Default "local" provides 100% zero-cost local filesystem storage.
STORAGE_PROVIDER="local"
S3_BUCKET_NAME="certificates"
# Cloudflare R2 example: https://<account_id>.r2.cloudflarestorage.com
# Supabase example: https://<project_ref>.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION_NAME="auto"
S3_PUBLIC_URL_PREFIX=""
